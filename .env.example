# ==============================================================================
# GiftGenie Environment Variables Configuration
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini Flash AI (Required for Gift Recommendations - 100% Free)
# ------------------------------------------------------------------------------
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended free tier models: gemini-1.5-flash or gemini-2.0-flash
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 2. Database & Authentication (Option A: Supabase - Recommended)
# ------------------------------------------------------------------------------
# Create a free project at: https://supabase.com
# Find these in Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Optional: Service Role key for elevated server operations
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 2. Database & Authentication (Option B: MongoDB)
# ------------------------------------------------------------------------------
# If you prefer MongoDB Atlas instead of Supabase, provide your connection URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/giftgenie?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. Optional Services & Admin Settings
# ------------------------------------------------------------------------------
# Admin panel login password (/admin/login)
ADMIN_API_KEY=admin12345

# Optional Amazon India Affiliate Tracking ID
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=giftgenie-21

# Optional secondary fallback AI provider (Groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
